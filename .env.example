# Sao chép thành .env.local nếu backend không chạy ở địa chỉ mặc định.
NEXT_PUBLIC_API_URL=http://localhost:5050

# true: các màn hình chưa có API (hợp đồng, mẫu, gói, quản trị, ký, xác minh) dùng dữ liệu mẫu trong src/lib/mock.
# Đăng nhập, doanh nghiệp và thành viên luôn gọi API thật. Đổi giá trị thì phải khởi động lại npm run dev.
NEXT_PUBLIC_USE_MOCK=false

# Đăng nhập Google qua Firebase (Firebase Console > Project settings > Your apps > Web). Giá trị công khai, không phải bí mật.
# Để trống thì ẩn nút "Tiếp tục với Google". Backend cần Firebase:ProjectId trùng projectId ở đây.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
