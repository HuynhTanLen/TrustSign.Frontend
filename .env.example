# Sao chép thành .env.local nếu backend không chạy ở địa chỉ mặc định.
NEXT_PUBLIC_API_URL=http://localhost:5050

# true: các màn hình chưa có API (hợp đồng, mẫu, gói, quản trị, ký, xác minh) dùng dữ liệu mẫu trong src/lib/mock.
# Đăng nhập, doanh nghiệp và thành viên luôn gọi API thật. Đổi giá trị thì phải khởi động lại npm run dev.
NEXT_PUBLIC_USE_MOCK=false
